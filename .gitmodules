[submodule "micropython"]
    path = potatao_phone/micropython
    url = https://github.com/micropython/micropython.git
    ignore = dirty

[submodule "pico-sdk"]
    path = potatao_phone/pico-sdk
    url = https://github.com/raspberrypi/pico-sdk.git

[submodule "pico-extras"]
    path = potatao_phone/pico-extras
    url = https://github.com/raspberrypi/pico-extras.git
    
[submodule "potatao_phone/modules/sqlite"]
	path = potatao_phone/modules/sqlite
	url = https://github.com/spatialdude/usqlite.git
    
[submodule "potatao_phone/tools/openocd"]
	path = potatao_phone/tools/openocd
	url = https://github.com/raspberrypi/openocd.git
    ignore = dirty 