; define the pio program name. When compile customized micro controller, compiler will convert to c struct
.program sdcard
; mention one pin can handle high voltage and low voltage. In this case, it should be CLK/SCK in sdcard part.
.side_set 1

; mention that this is the starting location of the state machine 
; "public" is key word that ensure this part is exported to c header
public entry_point:

; start zero-costing looping. In general cpu programming, if developers want to make a piece of code running in a loop,
; cpu should send jumping command whether it is end of loop. So, this command will occupy one cpu executing cycle.
; In sdcard, cpu send lots of jumping command for checking loop. It cause that I/O speed will be decreased.
; But in zero-costing, cpu doesn't need to send this command.
.wrap_target
    ; get data from FIFO(first-input-first-output) TX(sending data).
    ; in Raspberry pi pico 2 w, there exists 3 important physical parts, CPU, DMA and PIO.
    ; CPU focus on the command sending, DMA focus transmit data to FIFO. PIO can get data from FIFO to OSR (output shift register) and operate GPIO
    ; "block" is a key word in pio, it mean if FIFO is empty, PIO will wait util new data come in the FIFO. And there
    ; is another key word "noblock", PIO always get data from FIFO to OSR
    pull block  side 0
    ;init variable x = 7
    set x, 7    side 0
; start bit loop
bit_loop:
    ; out pins, 1 : throw out 1 bit data from OSR and send this data to MOSI. 
    ; side 0 : switch SCK to low voltage.
    ; [1]: make PIO wait 1 cpu cycle forcelly
    out pins, 1 side 0 [1]
    ; in pins, 1 : get 1 bit data from MISO and put this data into ISR(input shift register)
    ; side 1: switch sck to high voltage
    ; [1] : make PIO wait 1 cpu cycle forcelly
    in pins, 1 side 1 [1]
    jmp x-- bit_loop  side 0
    ; push these 8 bit data to FIFO RX that DMA/CPU can read that
    push block  side 0
.wrap